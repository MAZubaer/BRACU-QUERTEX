# Copy to .env for local use. On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Never commit .env.

# Neon Postgres. Use the POOLED connection string (host contains "-pooler").
# The Vercel-Neon integration fills DATABASE_URL and DATABASE_URL_UNPOOLED for you.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Optional: direct (unpooled) URL, used by scripts/ingest.py, sync_search.py and
# import_saved_pages.py for writes. In GitHub Actions it is the DATABASE_URL_UNPOOLED secret.
DATABASE_URL_UNPOOLED=

# Announcement search (scripts/sync_search.py only): app.tavily.com. Not needed on Vercel;
# in GitHub Actions it is the TAVILY_API_KEY secret.
TAVILY_API_KEY=

# LLM keys (free): console.groq.com/keys, aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional last resort: openrouter.ai/keys (its gpt-oss models are paid, a fraction of a cent per answer)
OPENROUTER_API_KEY=

# Providers and models, tried left to right; entries without a key are skipped.
# Change a name here if a model is retired.
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,openrouter:openai/gpt-oss-120b

# Search
USE_EMBEDDINGS=true
TOP_K=5
MAX_CONTEXT_WORDS=2500
TRANSLATE_QUERIES=true

# Query planner: one fast LLM call turns the question into search queries in the
# documents' wording (also resolves follow-ups and translates Bangla). Uses its own chain.
QUERY_PLANNER=true
PLANNER_CHAIN=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,openrouter:openai/gpt-oss-20b
MAX_PLANNED_QUERIES=4
PLANNED_TOP_K=7

# Answers
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_REASONING_EFFORT=low

# Public site guardrails
RATE_LIMIT_10MIN=10
RATE_LIMIT_DAY=40
MAX_QUESTION_CHARS=500
# Any random text; makes the stored IP hashes impossible to reverse.
IP_HASH_SALT=
